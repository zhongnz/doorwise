# DoorWise-NYC Environment Variables
# Copy this file to .env and fill in your values

# Google Cloud / Gemini API
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CLOUD_PROJECT=your_project_id_here
GOOGLE_CLOUD_REGION=us-central1
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_VISION_MODEL=gemini-2.5-flash

# Optional NYC Open Data app token for better rate limits and reliability.
SOCRATA_APP_TOKEN=your_optional_socrata_app_token_here

# Optional building context defaults for callback-based decisions
BUILDING_NAME=your_building_name_here
BUILDING_MANAGEMENT_PHONE=your_management_phone_here
BUILDING_SUPER_PHONE=your_super_phone_here
APPROVED_VENDORS=Ace Plumbing,BrightWire Electric

# Backend
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
